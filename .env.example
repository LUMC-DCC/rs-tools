# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every variable below is optional. Uncommented values mirror application
# defaults; commented assignments show optional examples.

# --- Core -------------------------------------------------------------------
# Redis connection. Redis holds all workspace state and nothing else does.
RS_TOOLS_REDIS_URL=redis://localhost:6379/0
# How long a workspace survives without activity, in seconds (12 hours).
RS_TOOLS_WORKSPACE_TTL_SECONDS=43200
# Largest accepted request body, in bytes (1 MB).
RS_TOOLS_MAX_REQUEST_BYTES=1048576
# Logging verbosity: DEBUG, INFO, WARNING, or ERROR.
RS_TOOLS_LOG_LEVEL=INFO
# Directory holding the built frontend. Defaults to frontend/dist beside the
# backend source; the container image sets its own path.
# RS_TOOLS_FRONTEND_DIST=/app/frontend/dist

# --- Public origin ----------------------------------------------------------
# The origin users reach this service on. Required for GitHub publishing, and
# used for the Location header. Without it those URLs would have to come from
# the request's Host header, which any client can forge.
# RS_TOOLS_PUBLIC_BASE_URL=https://rs-tools.example.org
# Host header allow-list. Set to your own hostnames in production; "*" accepts
# any host and is only appropriate for local development.
RS_TOOLS_TRUSTED_HOSTS=*
# Cross-origin browser access. Empty is correct for both development (the Vite
# dev server proxies /api) and production (one origin serves everything).
RS_TOOLS_CORS_ORIGINS=

# --- Rate limits ------------------------------------------------------------
# The service is anonymous, so these are what stop one client monopolizing it.
# Ordinary reads and edits, per window, per client address.
RS_TOOLS_RATE_LIMIT_REQUESTS=120
# Generating files, building repositories, and calling GitHub.
RS_TOOLS_RATE_LIMIT_HEAVY_REQUESTS=10
# Length of the counting window, in seconds.
RS_TOOLS_RATE_LIMIT_WINDOW_SECONDS=60

# --- Repository templates ---------------------------------------------------
# Copier source for generated repository scaffolds. This source runs trusted
# finalization tasks, so only configure a repository you control and review.
RS_TOOLS_REPOSITORY_TEMPLATE_URL=https://github.com/LUMC-DCC/rs-repo-templates.git
# Prefer a version tag here once template releases are available.
RS_TOOLS_REPOSITORY_TEMPLATE_REVISION=main
# Copier's native Git mirror cache. Compose sets an internal persistent path;
# set this when running the backend directly to avoid repeated full clones.
# COPIER_CACHE_DIR=/var/cache/rs-tools/copier

# --- GitHub publishing (optional) -------------------------------------------
# See docs/deployment/github.md. Requires RS_TOOLS_PUBLIC_BASE_URL to be set.
# RS_TOOLS_GITHUB_CLIENT_ID=Ov23li.example
# RS_TOOLS_GITHUB_CLIENT_SECRET=replace-me
# At least 32 unpredictable bytes, for example: openssl rand -base64 48
# RS_TOOLS_GITHUB_COOKIE_SECRET=replace-me
# In production prefer the _FILE variants, which read a mounted secret. Never
# set both an inline value and its _FILE counterpart.
# RS_TOOLS_GITHUB_CLIENT_SECRET_FILE=/run/secrets/rs-tools-github-client-secret
# RS_TOOLS_GITHUB_COOKIE_SECRET_FILE=/run/secrets/rs-tools-github-cookie-secret
# GitHub endpoints. Change only for GitHub Enterprise Server.
# RS_TOOLS_GITHUB_API_URL=https://api.github.com
# RS_TOOLS_GITHUB_WEB_URL=https://github.com
# RS_TOOLS_GITHUB_API_VERSION=2026-03-10
